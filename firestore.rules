rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Events — read-only (seeded once; re-seed via Firebase Console)
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Rounds — read + update only (admin can change round status)
    match /rounds/{roundId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if false;
    }

    // Matches — read + update only (live scoring updates)
    match /matches/{matchId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if false;
    }

    // Players — read + update only (admin can update handicaps/PINs)
    match /players/{playerId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if false;
    }

    // Chat — read + validated create, no edits or deletes
    match /chat/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['eventId', 'userId', 'userName', 'userTeam', 'text', 'timestamp'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500;
      allow update, delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
